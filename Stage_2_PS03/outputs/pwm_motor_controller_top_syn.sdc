set sdc_version 2.0

set_units -capacitance 1000fF
set_units -time 1000ps

# Set the current design
current_design pwm_motor_controller_top

create_clock -name "pclk" -period 10.0 -waveform {0.0 5.0} [get_ports pclk]
set_clock_transition 0.15 [get_clocks pclk]
set_false_path -from [get_ports presetn]
set_clock_gating_check -setup 0.0 
set_input_delay -clock [get_clocks pclk] -add_delay -max 2.0 [get_ports feedback_in]
set_input_delay -clock [get_clocks pclk] -add_delay -max 2.0 [get_ports fault_oc_in]
set_input_delay -clock [get_clocks pclk] -add_delay -max 3.0 [get_ports psel]
set_input_delay -clock [get_clocks pclk] -add_delay -max 3.0 [get_ports penable]
set_input_delay -clock [get_clocks pclk] -add_delay -max 3.0 [get_ports pwrite]
